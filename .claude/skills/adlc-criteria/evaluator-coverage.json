{
  "version": 1,
  "about": "What the lab's existing evaluators and metrics already check. scripts/criteria.py maps each criterion's checks to 已覆盖 / 部分覆盖 / 未覆盖 from this file; tests/test_define_skills.py keeps it in sync with evaluators/ (red-flag texts, the pillars observation keys it names, builtin evaluator ids).",
  "executors": ["代码断言", "裁判", "内置评估器", "指标读数"],
  "tiers": ["红线", "门禁", "观测"],
  "checks": [
    {"id": "label.important", "name": "是否重要与黄金集一致",
     "evaluator": "adlc_label_accuracy（注册名 …_label_important）", "field": "important（是/否，完全一致）",
     "executor": "代码断言", "tier": "门禁", "threshold": "准确率 ≥ TARGET_ACCURACY（默认 0.70）",
     "coverage": "covered", "needs_golden": true, "golden_requires": null, "assertable": true,
     "where": "43-run-eval.sh 终端结论的门禁；51-compare.sh 对比页"},
    {"id": "label.urgent", "name": "是否紧急与黄金集一致",
     "evaluator": "adlc_label_accuracy（注册名 …_label_urgent）", "field": "urgent（是/否，完全一致）",
     "executor": "代码断言", "tier": "门禁", "threshold": "准确率 ≥ TARGET_ACCURACY（默认 0.70）",
     "coverage": "covered", "needs_golden": true, "golden_requires": null, "assertable": true,
     "where": "43-run-eval.sh 终端结论的门禁；51-compare.sh 对比页"},
    {"id": "label.decision", "name": "处理建议在黄金集的可接受答案内",
     "evaluator": "adlc_label_accuracy（注册名 …_label_decision）", "field": "decision ∈ acceptable_decisions",
     "executor": "代码断言", "tier": "门禁", "threshold": "准确率 ≥ TARGET_ACCURACY（默认 0.70）",
     "coverage": "covered", "needs_golden": true, "golden_requires": null, "assertable": true,
     "where": "43-run-eval.sh 终端结论的门禁；51-compare.sh 对比页"},
    {"id": "label.level", "name": "优先级 P0/P1/P2 与黄金集一致（分级口径）",
     "evaluator": "adlc_label_accuracy（注册名 …_label_level）", "field": "level（ADLC_LABEL_SCHEME=level）",
     "executor": "代码断言", "tier": "门禁", "threshold": "准确率 ≥ TARGET_ACCURACY（默认 0.70）",
     "coverage": "partial", "gap": "默认是二元口径，不打优先级；按提示词 05 切到分级口径后才进门禁",
     "needs_golden": true, "golden_requires": null, "assertable": true,
     "where": "切换口径后同 label.decision"},
    {"id": "misreject", "name": "不可自动拒绝的需求不被判“拒绝”（误拒）",
     "evaluator": "adlc_label_accuracy", "field": "label=CriticalFail：黄金集 can_auto_reject=false 且 Agent 判“拒绝”",
     "executor": "代码断言", "tier": "红线", "threshold": null,
     "coverage": "covered", "needs_golden": true, "golden_requires": {"can_auto_reject": false}, "assertable": true,
     "where": "43-run-eval.sh 结论的红线；51-compare.sh 对比页“红线”"},
    {"id": "reject.flag.fabricated", "name": "拒绝话术不编造平台没有的功能或菜单路径",
     "evaluator": "adlc_reject_quality（red_flags）；原生 …_reject_quality_llm", "field": "红线：编造平台并不存在的功能或配置路径",
     "executor": "裁判", "tier": "红线", "threshold": null,
     "coverage": "partial", "gap": "现在由裁判判这条红线（手册：需要裁判才能判的东西判不成红线）；菜单路径可以对照能力目录 how_to 做代码断言，实验里还没有这个断言",
     "needs_golden": true, "golden_requires": {"decision_in": ["拒绝"]}, "assertable": true,
     "where": "43-run-eval.sh 结论的红线（话术红线）"},
    {"id": "reject.flag.promise_date", "name": "拒绝话术不承诺上线时间或排期",
     "evaluator": "adlc_reject_quality（red_flags）；原生 …_reject_quality_llm", "field": "红线：承诺具体上线时间或“下个版本一定做”",
     "executor": "裁判", "tier": "红线", "threshold": null,
     "coverage": "partial", "gap": "现在由裁判判；“下个版本 / X 月上线 / 一定做”这类说法可以用规则做代码断言，实验里还没有",
     "needs_golden": true, "golden_requires": {"decision_in": ["拒绝"]}, "assertable": true,
     "where": "43-run-eval.sh 结论的红线（话术红线）"},
    {"id": "reject.flag.leak", "name": "拒绝话术不出现其他客户名称或内部信息",
     "evaluator": "adlc_reject_quality（red_flags）；原生 …_reject_quality_llm", "field": "红线：泄露其他客户名称或内部敏感信息",
     "executor": "裁判", "tier": "红线", "threshold": null,
     "coverage": "partial", "gap": "现在由裁判判；其他客户名称可以对照客户名单做代码断言，实验里还没有",
     "needs_golden": true, "golden_requires": {"decision_in": ["拒绝"]}, "assertable": true,
     "where": "43-run-eval.sh 结论的红线（话术红线）"},
    {"id": "reject.flag.empty_or_contradict", "name": "判“拒绝”时话术非空且与内部理由一致",
     "evaluator": "adlc_reject_quality（red_flags）", "field": "红线：话术为空，或与内部理由互相矛盾",
     "executor": "裁判", "tier": "红线", "threshold": null,
     "coverage": "partial", "gap": "现在由裁判判；“话术为空”可以做代码断言，“互相矛盾”仍需裁判",
     "needs_golden": true, "golden_requires": {"decision_in": ["拒绝"]}, "assertable": false,
     "where": "43-run-eval.sh 结论的红线（话术红线）"},
    {"id": "reject.quality", "name": "拒绝理由与话术评审通过（五项换算 ≥ 0.7 且无红线）",
     "evaluator": "adlc_reject_quality", "field": "label=Pass / value ≥ 0.7",
     "executor": "裁判", "tier": "门禁", "threshold": "通过率 ≥ TARGET_ACCURACY（默认 0.70）",
     "coverage": "covered", "needs_golden": true, "golden_requires": {"decision_in": ["拒绝"]}, "assertable": false,
     "where": "43-run-eval.sh 结论的门禁“拒绝话术通过率”"},
    {"id": "reject.subscores", "name": "话术分项：理由专业性 / 理解与礼貌 / 原因说明 / 替代方案 / 风险控制",
     "evaluator": "adlc_reject_quality", "field": "explanation 里的 A–E 分项（1–5 分）",
     "executor": "裁判", "tier": "观测", "threshold": "只看趋势",
     "coverage": "covered", "needs_golden": true, "golden_requires": {"decision_in": ["拒绝"]}, "assertable": false,
     "where": "51-compare.sh 对比页“话术分项”"},
    {"id": "reject.points", "name": "拒绝理由与话术覆盖黄金集要点",
     "evaluator": "adlc_reject_quality", "field": "未覆盖要点（对照黄金集 reject_points / reply_points）",
     "executor": "裁判", "tier": "观测", "threshold": "只看趋势",
     "coverage": "covered", "needs_golden": true, "golden_requires": {"decision_in": ["拒绝"]}, "assertable": false,
     "where": "51-compare.sh 对比页“未覆盖要点”"},
    {"id": "capability_hit", "name": "判断依据引用了相关能力（能力目录命中率）",
     "evaluator": "汇总报告（三大支柱的观测 capability_hit）", "field": "Agent 输出里出现黄金集 matched_capabilities 的能力编号",
     "executor": "代码断言", "tier": "观测", "threshold": "只看趋势",
     "coverage": "covered", "needs_golden": true, "golden_requires": {"has_capabilities": true}, "assertable": true,
     "where": "batch_score.py 报告；51-compare.sh 对比页"},
    {"id": "format", "name": "输出是约定的 JSON（三项标签都能解析）",
     "evaluator": "adlc_label_accuracy", "field": "label=FormatError（观测：格式错误率）",
     "executor": "代码断言", "tier": "观测", "threshold": "只看趋势",
     "coverage": "covered", "needs_golden": false, "golden_requires": null, "assertable": true,
     "where": "43-run-eval.sh 结果；51-compare.sh 对比页"},
    {"id": "by_dimension", "name": "按五维标签 / 样例类型（简单、模糊、对抗、应拒绝）分组的准确率",
     "evaluator": "汇总报告（三大支柱的观测 by_dimension / by_case_type）", "field": "黄金集 dimensions / case_type",
     "executor": "代码断言", "tier": "观测", "threshold": "只看趋势",
     "coverage": "covered", "needs_golden": true, "golden_requires": null, "assertable": true,
     "where": "python -m labkit.failures；51-compare.sh 对比页"},
    {"id": "decision_mix", "name": "处理建议分布（例如“待评估”占比）",
     "evaluator": "汇总报告（三大支柱的观测 decisions）；60-triage-report.sh 分诊报告", "field": "各处理建议的条数",
     "executor": "指标读数", "tier": "观测", "threshold": "只看分布",
     "coverage": "partial", "gap": "只展示分布，没有阈值判定（例如“待评估 ≤ 20%”没人检查）",
     "needs_golden": false, "golden_requires": null, "assertable": true,
     "where": "60-triage-report.sh 分诊报告的汇总；51-compare.sh 对比页"},
    {"id": "builtin.correctness", "name": "回答正确性（对照期望输出）",
     "evaluator": "Builtin.Correctness（内置评估器）", "field": "label / value",
     "executor": "内置评估器", "tier": "观测", "threshold": "只看平均分",
     "coverage": "covered", "needs_golden": true, "golden_requires": null, "assertable": false,
     "where": "43-run-eval.sh 结果；51-compare.sh 对比页"},
    {"id": "builtin.helpfulness", "name": "回答有用性",
     "evaluator": "Builtin.Helpfulness（内置评估器，在线评估也挂了它）", "field": "label / value",
     "executor": "内置评估器", "tier": "观测", "threshold": "只看平均分",
     "coverage": "covered", "needs_golden": false, "golden_requires": null, "assertable": false,
     "where": "43-run-eval.sh 结果；41-online-eval.sh 控制台"},
    {"id": "metric.latency", "name": "单条处理耗时 / 整批耗时",
     "evaluator": "不是评估器：每次运行的记录 latency_ms（labkit.batch）、分诊报告的耗时", "field": "latency_ms",
     "executor": "指标读数", "tier": "观测", "threshold": "只看读数",
     "coverage": "partial", "gap": "每条都记录了耗时，但没有阈值判定（单条上限、整批时长都没人检查）",
     "needs_golden": false, "golden_requires": null, "assertable": true,
     "where": "results/run-*.jsonl 的 latency_ms；60-triage-report.sh 分诊报告"},
    {"id": "metric.tokens", "name": "单条 token 用量 / 模型调用次数（折算成本）",
     "evaluator": "不是评估器：span 属性 gen_ai.usage.*（ext-check-telemetry.sh 检查有没有记录）、CloudWatch GenAI Observability", "field": "gen_ai.usage.input_tokens / output_tokens",
     "executor": "指标读数", "tier": "观测", "threshold": "只看读数",
     "coverage": "partial", "gap": "span 上记录了 token 用量，但实验没有按条汇总成费用，也没有阈值判定",
     "needs_golden": false, "golden_requires": null, "assertable": true,
     "where": "CloudWatch 控制台 → GenAI Observability；ext-check-telemetry.sh"},
    {"id": "metric.errors", "name": "处理失败（超时 / 报错）条数",
     "evaluator": "不是评估器：每次运行的记录 error、分诊报告“处理失败（需要重跑）”", "field": "error",
     "executor": "指标读数", "tier": "观测", "threshold": "只看读数",
     "coverage": "partial", "gap": "列出了失败条目，但没有阈值判定（例如“整批失败 0 条”没人检查）",
     "needs_golden": false, "golden_requires": null, "assertable": true,
     "where": "60-triage-report.sh 分诊报告"}
  ]
}
