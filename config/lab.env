# =============================================================================
# 场景 12 实验 - 全局配置（唯一来源 / single source of truth）
# 所有脚本（bash 与 python）都从这里读取；个人覆盖写在 config/local.env（不提交）。
# 格式：纯 KEY=VALUE，一行一个；# 开头为注释。
# =============================================================================

# 区域：workshop 区域待定，us-west-2 或 us-east-1，二选一
AWS_REGION=us-west-2

# 资源名前缀（所有实验资源都以它开头，清理脚本按它查找）
LAB_PREFIX=s12lab

# Agent 本体模型（Bedrock 推理配置文件 ID）
AGENT_MODEL_ID=us.anthropic.claude-sonnet-5-5
# LLM 评审评估器使用的模型
JUDGE_MODEL_ID=us.anthropic.claude-sonnet-5-5
# 一行切换的备选模型：./tools/use-model.sh nova
FALLBACK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# EC2 上 Coding Agent（Claude Code）使用的模型
CODING_AGENT_MODEL_ID=us.anthropic.claude-sonnet-5-5
CODING_AGENT_FAST_MODEL_ID=us.anthropic.claude-haiku-5-5

# Agent 版本：v0（故意偏弱的基线）或 v1（优化后）
AGENT_VERSION=v0

# 评估目标：三项标签准确率阈值
TARGET_ACCURACY=0.70

# Runtime 运行时 Python 版本（AgentCore Runtime 直接代码部署）
RUNTIME_PYTHON=PYTHON_3_12

# 可选：本机（非 EC2）运行时使用的 AWS CLI profile；EC2 上留空（使用实例角色）。
# 个人设置请写到 config/local.env，例如 AWS_PROFILE=my-lab-profile
AWS_PROFILE=
